{
  "name": "@roost2d/chikn-rigs",
  "version": "0.1.0-rc.5",
  "description": "Apache-2.0 Chikn and Roostr rig and animation metadata for Roost2D.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roost2D/roost2d.git",
